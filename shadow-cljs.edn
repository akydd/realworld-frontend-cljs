{:source-paths
 ["src/main"
  "src/test"]

 :dependencies
 [[reagent "2.0.1"]
  [binaryage/devtools "1.0.7"]
  [re-frame/re-frame "1.4.3"]
  [day8.re-frame/re-frame-10x "1.9.3"]
  [day8.re-frame/tracing "0.6.2"]
  [day8.re-frame/http-fx "0.2.4"]
  [metosin/reitit "0.9.2"]
  [com.smxemail/re-frame-cookie-fx "0.0.2"]
  [markdown-clj "1.12.5"]
  [org.clj-commons/hickory "0.7.7"]]

 :dev-http
 {3000 "public"}

 :builds
 {:app
  {:target     :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules    {:main
                {:init-fn realworld-clojurescript.app.core/main}}
   :compiler-options {:optimizations :none
                      :closure-defines {re-frame.trace.trace-enabled?        true
                                        day8.re-frame.tracing.trace-enabled? true}}
   :devtools {:preloads [day8.re-frame-10x.preload]}}

  :test
  {:target     :node-test
   :output-to  "out/node/tests.js"
   :autorun    true}

  :test-browser
  {:target     :browser-test
   :test-dir   "out/browser/test"
   :devtools   {:http-port 3021
                :http-root "out/browser/test"}}}}
